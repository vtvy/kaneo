{
	"expo": {
		"name": "Kaneo",
		"slug": "kaneo",
		"version": "0.1.0",
		"orientation": "portrait",
		"scheme": "kaneo",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "com.kaneo.mobile",
			"supportsTablet": true,
			"infoPlist": {
				"NSAppTransportSecurity": {
					"NSAllowsArbitraryLoads": true
				}
			}
		},
		"android": {
			"package": "com.kaneo.mobile",
			"usesCleartextTraffic": true
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"expo-build-properties",
				{
					"android": {
						"usesCleartextTraffic": true
					}
				}
			],
			"./plugins/with-release-signing.js"
		]
	}
}
