{
	"name": "@kaneo/importers",
	"version": "0.0.0",
	"private": true,
	"description": "Read projects from PLANKA and Jira into one import model",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"license": "MIT",
	"scripts": {
		"build": "tsc",
		"lint": "biome check --write .",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts"
	},
	"dependencies": {
		"turndown": "^7.2.2",
		"turndown-plugin-gfm": "^1.0.2"
	},
	"devDependencies": {
		"@kaneo/typescript-config": "workspace:*",
		"@types/node": "^25.3.5",
		"@types/turndown": "^5.0.6",
		"typescript": "^5.9.2",
		"vitest": "^4.1.6"
	}
}
